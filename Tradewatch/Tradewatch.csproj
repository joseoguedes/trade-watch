<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Bump before tagging a release (git tag vX.Y.Z) -->
    <Version>1.2.0</Version>
    <!-- Generated by tools/make_icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Single-file publish: pack WPF's native DLLs into the exe too, so Tradewatch.exe runs on its own. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built into the exe so the single-file release can't lose it. -->
    <EmbeddedResource Include="holidays.json" LogicalName="holidays.json" />
  </ItemGroup>

</Project>
